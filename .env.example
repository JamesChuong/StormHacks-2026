# Copy to .env (never commit .env).

# Gemini: leave empty to run agents in "mock" mode (replays reference solutions).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Services (Docker Compose hostnames)
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+psycopg2://arena:arena@postgres:5432/arena
PISTON_URL=http://piston:2000

# Used by the postgres container
POSTGRES_USER=arena
POSTGRES_PASSWORD=arena
POSTGRES_DB=arena

# Match tuning
BETTING_SECONDS=20
CHALLENGES_PER_MATCH=3
MAX_ATTEMPTS=3
MM_WAIT_SECONDS=15

# Solana (Phase 4): orchestrator keypair path and RPC
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ORCHESTRATOR_KEYPAIR=
